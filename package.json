{
  "name": "stable-shop-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm build",
    "dev": "concurrently -k \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "db:migrate:mysql": "tsx scripts/migrate-mysql.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "hono": "^4.7.2",
    "mysql2": "^3.23.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
